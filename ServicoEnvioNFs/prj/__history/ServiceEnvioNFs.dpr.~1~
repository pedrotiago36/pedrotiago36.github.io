program ServiceEnvioNFs;

{
  Comportamento ao rodar o .exe diretamente:
    - Abre a tela de reinstalacao automatica (para -> desinstala -> instala -> inicia)

  Parametros internos do Windows Service Manager (nao usar manualmente):
    /install /silent  -> instala o servico (chamado pela propria tela)
    /uninstall        -> desinstala
}

uses
  Winapi.Windows,
  System.SysUtils,
  Vcl.Forms,
  Vcl.SvcMgr,
  View.TServiceEnvioNFs   in '..\View\View.TServiceEnvioNFs.pas',
  View.TInstalador        in '..\Instalador\View.TInstalador.pas',
  Controller.TInstalador  in '..\Instalador\Controller.TInstalador.pas',
  Service.TWorkerThread   in '..\Service\Service.TWorkerThread.pas',
  Controller.TAgendamento in '..\Controller\Classes\Controller.TAgendamento.pas',
  Controller.IAgendamento in '..\Controller\Interfaces\Controller.IAgendamento.pas',
  Model.TConfiguracaoModel   in '..\Model\Classes\Model.TConfiguracaoModel.pas',
  Model.IConfiguracaoModel   in '..\Model\Interfaces\Model.IConfiguracaoModel.pas',
  Model.TNotificadorModel    in '..\Model\Classes\Model.TNotificadorModel.pas',
  Model.INotificadorModel    in '..\Model\Interfaces\Model.INotificadorModel.pas',
  Shared.Tipos            in '..\Shared\Shared.Tipos.pas';

{$R *.res}

procedure AbrirInstalador;
var
  LFrm: TFrmInstalador;
begin
  Application.Initialize;
  Application.Title := 'Servico NFSe - Instalador';
  LFrm := TFrmInstalador.CreateNew(Application);
  try
    LFrm.ShowModal;
  finally
    LFrm.Free;
  end;
end;

procedure IniciarComoServico;
begin
  case Application.DelayInitialize and not Application.Installing of
    False: Application.Initialize;
  end;
  Application.CreateForm(TServiceEnvioNFs, ServiceEnvioNFs);
  Application.Run;
end;

begin
  case FindCmdLineSwitch('install') or
       FindCmdLineSwitch('uninstall') of
    True : IniciarComoServico;
    False:
      case Application.Installing of
        True : IniciarComoServico;
        False: AbrirInstalador;
      end;
  end;
end.
